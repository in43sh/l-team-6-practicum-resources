# Combined starter template for BOTH frontend and backend projects.
# Use only the section(s) your project actually needs.
# If your repo has separate frontend/ and backend/ folders, give each app its own .env.example file.
#
# Frontend note:
# Variables used in the browser are public because they ship to the client.
# Only put public frontend config here, not secrets or private tokens.

# ====================
# Frontend only (Vite)
# ====================
VITE_API_BASE_URL=
VITE_PUBLIC_APP_NAME=

# ========================================
# Frontend only (Create React App legacy)
# ========================================
REACT_APP_API_BASE_URL=

# ===================
# Backend server only
# ===================
PORT=3000
MONGO_URI=
SESSION_SECRET=
JWT_SECRET=
